# UQPAY React Native example (Expo variant) — copy to `example-expo/.env`.
#
#   cp example-expo/.env.template example-expo/.env
#   $EDITOR example-expo/.env
#   node example-expo/scripts/gen-env.mjs
#
# `example-expo/.env` is gitignored. Never paste a value into a chat, a commit,
# a screenshot or an issue.
#
# The APP reads exactly three of these, through example-expo/scripts/gen-env.mjs
#   → UQPAY_ENVIRONMENT, UQPAY_CLIENT_ID, UQPAY_MERCHANT_BACKEND_URL
#
# The reference merchant BACKEND is shared with the bare sample app: it lives in
# `example/backend/` and reads its own `example/.env`. The API key and the
# webhook/on-behalf-of settings are listed here only so the two files have the
# same six names — the backend does not read this copy, and the app must never
# read the key. A test fails if anything under example-expo/src so much as names
# UQPAY_API_KEY (AC RN-SEC3). An API key in a mobile app is a compromise, not a
# shortcut.

# sandbox | production  — production additionally requires UQPAY_ALLOW_PRODUCTION=1
UQPAY_ENVIRONMENT=sandbox

# Merchant client id. Not a secret, but it identifies you; the app sends it.
UQPAY_CLIENT_ID=

# ⚠️  BACKEND ONLY (example/.env). The app must NEVER read this.
UQPAY_API_KEY=

# Where the app finds the reference backend (`node example/backend/server.mjs`).
# iOS simulator uses it as-is; the Android emulator rewrites localhost to
# 10.0.2.2 automatically (an emulator's "localhost" is the emulator itself).
UQPAY_MERCHANT_BACKEND_URL=http://localhost:8787

# Informational: the public URL you registered with UQPAY for webhooks, e.g.
# an ngrok / Cloudflare tunnel pointing at the backend's /webhooks/uqpay.
UQPAY_WEBHOOK_URL=

# Optional: UQPAY Connect sub-account, sent as x-on-behalf-of. Backend only.
UQPAY_ON_BEHALF_OF=

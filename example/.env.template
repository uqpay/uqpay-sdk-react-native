# UQPAY React Native example — copy to `example/.env` and fill in.
#
#   cp example/.env.template example/.env
#   $EDITOR example/.env
#   node example/scripts/gen-env.mjs
#
# `example/.env` is gitignored. Never paste a value into a chat, a commit, a
# screenshot or an issue.
#
# Two consumers, deliberately unequal:
#
#   the APP      reads exactly three variables, via example/scripts/gen-env.mjs
#                → UQPAY_ENVIRONMENT, UQPAY_CLIENT_ID, UQPAY_MERCHANT_BACKEND_URL
#   the BACKEND  (example/backend/) reads all of them, including the API key
#
# A test fails if anything under example/src so much as names UQPAY_API_KEY
# (AC RN-SEC3). An API key in a mobile app is a compromise, not a shortcut.

# sandbox | production  — production additionally requires UQPAY_ALLOW_PRODUCTION=1
UQPAY_ENVIRONMENT=sandbox

# Merchant client id. Not a secret, but it identifies you; the app sends it.
UQPAY_CLIENT_ID=

# ⚠️  BACKEND ONLY. The app must NEVER read this.
UQPAY_API_KEY=

# Where the app finds the reference backend. The port is taken from this URL.
# iOS simulator uses it as-is; the Android emulator rewrites localhost to
# 10.0.2.2 automatically (an emulator's "localhost" is the emulator itself).
UQPAY_MERCHANT_BACKEND_URL=http://localhost:8787

# Informational: the public URL you registered with UQPAY for webhooks, e.g.
# an ngrok / Cloudflare tunnel pointing at this backend's /webhooks/uqpay.
UQPAY_WEBHOOK_URL=

# Optional: UQPAY Connect sub-account, sent as x-on-behalf-of. Backend only.
UQPAY_ON_BEHALF_OF=

# Safety catch. Required, and only honoured, when UQPAY_ENVIRONMENT=production.
# UQPAY_ALLOW_PRODUCTION=1

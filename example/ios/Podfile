# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ReactNativeExample' do
  # AC RN-TEST5: declare the library explicitly so CocoaPods integrates its
  # `test_spec` and generates the `uqpay-react-native-Unit-Tests` target/scheme.
  # React Native's autolinking skips any pod the Podfile has already activated
  # (`react-native/scripts/cocoapods/autolinking.rb`: "Skip dependencies that the
  # user already activated themselves"), so this does not double-link.
  #
  # `:testspecs => ['Tests']` builds and runs the SDK's OWN internal XCTest
  # target as part of this example app's Pod integration. This is exclusively
  # for this repo's CI/tester workflow. Merchants integrating the published
  # `uqpay-react-native` pod must NOT copy this line into their own Podfile —
  # a normal `pod 'uqpay-react-native'` (no `:testspecs`) is all an app needs.
  pod 'uqpay-react-native', :path => '../..', :testspecs => ['Tests']

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end

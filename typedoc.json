{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.json",
  "plugin": ["typedoc-plugin-markdown"],
  "out": "docs/api",
  "excludeInternal": true,
  "excludePrivate": true,
  "treatWarningsAsErrors": true,
  "readme": "none",
  "githubPages": false,
  "disableSources": true,
  "hideGenerator": true,
  "cleanOutputDir": true
}

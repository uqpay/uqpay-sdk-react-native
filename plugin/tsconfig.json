{
  // Standalone (does NOT extend the root config): the plugin runs under plain
  // Node during `expo prebuild`, so it is emitted as CommonJS/ES2019 rather
  // than the bundler-resolved ESM the app-side source uses.
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "build",
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}

{
  "name": "@uqpay/react-native",
  "version": "1.0.0-rc.1",
  "description": "UQPAY payment sheet for React Native (wraps the native iOS and Android SDKs)",
  "main": "./lib/commonjs/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "uqpay-react-native-source": "./src/index.ts",
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "default": "./lib/module/index.js"
    },
    "./jest": {
      "uqpay-react-native-source": "./src/jest/index.ts",
      "require": {
        "types": "./lib/typescript/commonjs/src/jest/index.d.ts",
        "default": "./lib/commonjs/jest/index.js"
      },
      "import": {
        "types": "./lib/typescript/module/src/jest/index.d.ts",
        "default": "./lib/module/jest/index.js"
      },
      "default": "./lib/module/jest/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "app.plugin.js",
    "plugin/build",
    "jest",
    "docs",
    "!docs/internal",
    "ERROR_CODES.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "PRIVACY.md",
    "STABILITY.md",
    "!ios/Tests",
    "!android/src/test",
    "!ios/build",
    "!ios/generated",
    "!android/build",
    "!android/generated",
    "!android/.gradle",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @uqpay/react-native-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib temp coverage",
    "prepare": "bob build && tsc -p plugin",
    "plugin:build": "tsc -p plugin",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/extract-readme-snippets.mjs && tsc -p docs-fixtures",
    "docs:api": "typedoc",
    "docs:api:check": "node scripts/check-api-docs.mjs",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "errors:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-error-codes.ts",
    "errors:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-error-table.ts",
    "pod:lint": "pod lib lint uqpay-react-native.podspec --allow-warnings --skip-tests"
  },
  "keywords": [
    "uqpay",
    "payment",
    "payment-sheet",
    "react-native",
    "turbo-module",
    "expo-config-plugin",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uqpay/uqpay-sdk-react-native.git"
  },
  "author": "UQPAY (https://uqpay.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/uqpay/uqpay-sdk-react-native/issues"
  },
  "homepage": "https://github.com/uqpay/uqpay-sdk-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "^57.0.9",
    "@jest/globals": "^29.7.0",
    "@microsoft/api-extractor": "^7.59.1",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tsdoc": "^0.5.3",
    "expect-type": "^1.2.2",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "turbo": "^2.10.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=10.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "workspaces": [
    "example",
    "example-expo"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "UqpaySpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.uqpay.reactnative"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.63.1"
  },
  "module": "./lib/module/index.js"
}
